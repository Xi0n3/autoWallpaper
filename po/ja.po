msgstr "画像を切り替える順序を設定します。"

msgid "Se han detectado cambios en los fondos almacenados. "
msgstr "保存された壁紙の変更が検出されました。 "

msgid "Recarga"
msgstr "再読み込み"

msgid "Recargar fondos ahora"
msgstr "今すぐ壁紙を再読み込み"

