msgid "Rotation sequence"
msgstr "Послідовність зміни"

msgid "Random"
msgstr "Випадково"

msgid "Random without repeats (full deck)"
msgstr "Випадково без повторень (повна колода)"

msgid "Automatic rotation"
msgstr "Автоматична зміна"

msgid "Timer and background change automation."
msgstr "Таймер та автоматична зміна у фоновому режимі."

msgid "Enable automatic rotation"
msgstr "Увімкнути автоматичну зміну"

msgid "Enable service to switch wallpapers based on scheduled frequency"
msgstr "Увімкнути службу для зміни зображень за запланованим розкладом"

msgid "Switch frequency"
msgstr "Частота зміни"

msgid "Time interval (minutes)"
msgstr "Інтервал часу (хвилини)"

msgid "Fixed daily time"
msgstr "Фіксований щоденний час"

msgid "Minutes between switches"
msgstr "Хвилини між змінами"

msgid "Time each wallpaper remains active"
msgstr "Час показу кожних шпалер"

msgid "Daily switch time"
msgstr "Час щоденної зміни"

msgid "Scheduled time to rotate wallpaper each day (24h format)"
msgstr "Запланований час щоденної зміни шпалер (формат 24г)"

msgid "Hour (00 to 23)"
msgstr "Година (від 00 до 23)"

msgid "Minutes (00 to 59)"
msgstr "Хвилини (від 00 до 59)"

msgid "Days between switches"
msgstr "Дні між змінами"

msgid "Frequency in days for daily rotation"
msgstr "Частота в днях для щоденної зміни"

msgid "Count unseen style change as rotation"
msgstr "Враховувати зміну стилю як зміну шпалер, якщо фон ще не переглядався"

msgid "When switching between light and dark, if the wallpaper was not yet seen, restart the timer (interval mode only)"
msgstr "При перемиканні між світлою та темною темою, якщо шпалери ще не переглядалися, перезапускає таймер (лише в режимі інтервалу)"

msgid "Tools and Maintenance"
msgstr "Інструменти та обслуговування"

msgid "Maintenance, active wallpaper management, smart organization, and optimization."
msgstr "Обслуговування, керування активними шпалерами, розумна організація та оптимізація."

msgid "Current wallpaper on screen"
msgstr "Поточні шпалери на екрані"

msgid "Detecting active wallpaper..."
msgstr "Визначення видимих шпалер..."

msgid "Locate and show file in Files (Nautilus)"
msgstr "Знайти та показати файл у Файлах (Nautilus)"

msgid "Pin wallpaper in pinned/ (protect in this theme)"
msgstr "Закріпити у pinned/ (захистити в цій темі)"

msgid "Exclude wallpaper from rotation (move to exclude/)"
msgstr "Виключити зі зміни (перемістити до exclude/)"

msgid "No wallpaper configured or file does not exist"
msgstr "Шпалери не налаштовано або файл не існує"

msgid "Pinned"
msgstr "Закріплено (pinned)"

msgid "Unpin wallpaper (return to main folder)"
msgstr "Відкріпити шпалери (повернути до головної теки)"

msgid "Pin wallpaper in pinned/ (do not rotate away)"
msgstr "Закріпити у pinned/ (не переміщувати з цієї теми)"

