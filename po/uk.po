msgid "Click to change light wallpaper (Default)"
msgstr "Натисніть, щоб змінити світлі шпалери (Типовий)"

msgid "Click to change dark wallpaper (Dark)"
msgstr "Натисніть, щоб змінити темні шпалери (Темний)"

msgid "Default"
msgstr "Типовий"

msgid "Dark"
msgstr "Темний"

msgid "changing theme"
msgstr "змінюючи тему"

msgid "Wallpaper changed for theme"
msgstr "Шпалери для теми змінено"

msgid "view it by"
msgstr "можна побачити"

msgid "Select light wallpaper"
msgstr "Вибрати світлі шпалери"

msgid "Select dark wallpaper"
msgstr "Вибрати темні шпалери"

msgid "Wallpaper Folders"
msgstr "Теки шпалер"

msgid "Select the image folders assigned to each theme."
msgstr "Виберіть теки зображень, призначені для кожної теми."

