msgid "Enable anyway"
msgstr "Усе одно ввімкнути"

msgid "Start upscaling"
msgstr "Почати масштабування"

msgid "Upscaling wallpapers with Real-CUGAN..."
msgstr "Масштабування шпалер за допомогою Real-CUGAN..."

