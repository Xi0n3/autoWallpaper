msgstr "Налаштуйте порядок показу зображень."

msgid "Changes detected in stored wallpapers. "
msgstr "Виявлено зміни у збережених шпалерах. "

msgid "Reload"
msgstr "Перезавантажте"

msgid "Reload wallpapers now"
msgstr "Перезавантажити шпалери зараз"

msgid " to update wallpapers"
msgstr " для оновлення шпалер"

msgid "Dismiss notice"
msgstr "Закрити сповіщення"

msgid "Background Service"
msgstr "Фонова служба"

msgid "Checking status..."
msgstr "Перевірка стану..."

