msgstr "Яскравість L*"

msgid "Smart Upscale (Real-CUGAN)"
msgstr "Розумне масштабування (Real-CUGAN)"

msgid "The upscaling process uses Vulkan GPU neural acceleration. It may take some time and temporarily affect performance while running."
msgstr "Процес масштабування використовує нейромережеве прискорення GPU (Vulkan). Це може зайняти деякий час і тимчасово вплинути на продуктивність комп'ютера."

msgid "AI Upscale Parameters"
msgstr "Параметри масштабування з ШІ"

msgid "Enhance sharpness and resolution using Real-CUGAN."
msgstr "Покращуйте чіткість і роздільну здатність за допомогою Real-CUGAN."

msgid "Detected GPU:"
msgstr "Виявлений GPU:"

msgid "Folder to upscale"
msgstr "Тека для масштабування"

msgid "☀️ Light collection"
msgstr "☀️ Світла колекція"

msgid "🌙 Dark collection"
msgstr "🌙 Темна колекція"

msgid "🌓 Both collections (light and dark)"
msgstr "🌓 Обидва набори (світлий і темний)"

msgid "Scale factor"
msgstr "Коефіцієнт масштабування"

msgid "Resolution multiplier"
msgstr "Множник роздільної здатності"

msgid "2x (Recommended for 1080p -> 4K)"
msgstr "2x (Рекомендовано для 1080p -> 4K)"

msgid "Noise Reduction (Denoise)"
msgstr "Зниження шуму (Denoise)"

msgid "Artifact and compression cleanup level"
msgstr "Рівень очищення артефактів і стиснення"

msgid "Level 0 - Default (Optimal sharpness)"
msgstr "Рівень 0 - Типовий (Оптимальна чіткість)"

msgid "Level 1 - Soft"
msgstr "Рівень 1 - М'який"

msgid "Level 2 - Medium"
msgstr "Рівень 2 - Середній"

msgid "Level 3 - Strong"
msgstr "Рівень 3 - Сильний"

msgid "Level -1 - No denoise (Preserves grain)"
msgstr "Рівень -1 - Без шумозаглушення (Зберігати зернистість)"

msgid "Resolution limit"
msgstr "Обмеження роздільної здатності"

msgid "Skip images that already reach or exceed this size"
msgstr "Пропускати зображення, які вже досягли або перевищують цей розмір"

msgid "2560x1440 (2K QHD - Recommended)"
msgstr "2560x1440 (2K QHD - Рекомендовано)"

msgid "1920x1080 (Full HD)"
msgstr "1920x1080 (Full HD)"

msgid "3840x2160 (4K UHD)"
msgstr "3840x2160 (4K UHD)"

msgid "No limit (process all images)"
msgstr "Без обмежень (обробляти всі зображення)"

msgid "Backup copy"
msgstr "Резервна копія"

