msgstr "Исключить эти обои?"

msgid "se moverá a la carpeta 'exclude/' y se cambiará al siguiente fondo disponible de la rotación."
msgstr "файл будет перемещён в папку 'exclude/', и произойдёт переход к следующим обоям."

msgid "Cancelar"
msgstr "Отмена"

msgid "Excluir"
msgstr "Исключить"

